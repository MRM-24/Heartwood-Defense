{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/icons.mjs",
    "test:engine": "esbuild scripts/test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/test.cjs && node node_modules/.cache/test.cjs",
    "test:ui": "esbuild scripts/ssr.tsx --bundle --platform=node --format=cjs --jsx=automatic --loader:.tsx=tsx --outfile=node_modules/.cache/ssr.cjs && node node_modules/.cache/ssr.cjs",
    "test:dom": "esbuild scripts/dom.ts --bundle --platform=node --format=cjs --jsx=automatic --loader:.tsx=tsx --external:jsdom --outfile=node_modules/.cache/dom.cjs && node node_modules/.cache/dom.cjs",
    "test": "npm run test:engine && npm run test:ui && npm run test:dom",
    "sim": "esbuild scripts/sim.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/sim.cjs && node node_modules/.cache/sim.cjs",
    "sim:novice": "esbuild scripts/novice.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/novice.cjs && node node_modules/.cache/novice.cjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.44.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
